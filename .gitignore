# .gitignore: Lista lo que git no debe subir al repositorio.
# cada línea es un archivo o carpeta a ignorar

# Paquetes descargados por npm: pesan mucho y se recrean con el comando "npm install".
node_modules

# Resultado de "npm run build" del frontend: esta se puede volver a generar.
dist

# Las fotos subidas por los usuarios no se carguen o se ignoren.
# El asteriscto (*) significa "todo lo que haya denntro de uploads se va a ignorar".
backend/uploads/*

# Excepción: el signo ! significa "Esta línea SÍ se sube".
# Git no guarda carpetas vacías, solo archivos. Por eso dejamos dentro de la carpeta uploads un archivo llamado .gitkeep (Su único trabajo es mantener la carpeta)-
!backend/uploads/.gitkeep
